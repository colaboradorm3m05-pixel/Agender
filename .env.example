# Copie para .env e ajuste. Nunca versione o arquivo .env.

# PostgreSQL. Em desenvolvimento, `npm run db:dev` sobe um banco local nesta URL.
DATABASE_URL=postgres://postgres:postgres@localhost:54320/agender

# Segredo do Better Auth (mín. 32 caracteres aleatórios). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# URL pública da aplicação (usada em links de reserva e cookies).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nome do produto (provisório). Opcional.
NEXT_PUBLIC_APP_NAME=Agender

# Senha da conta de demonstração criada por `npm run db:seed:demo` (apenas desenvolvimento).
DEMO_PASSWORD=demo-agender-2026

# ---- Integrações ainda NÃO configuradas (ver docs/integracoes.md) ----
# E-mail transacional para lembretes (ex.: Resend). Sem isso, lembretes ficam indisponíveis.
# RESEND_API_KEY=
# EMAIL_FROM=
